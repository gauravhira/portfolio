# Password for the ops subdomain (ops.gauravhira.dev)
# Used as both the login password and the HMAC signing key for session tokens.
OPS_PASSWORD=change-me

# Supabase project used by the ops leads dashboard (server-side only, never exposed to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me

# Zoho SMTP credentials used to send lead outreach emails (server-side only)
ZOHO_EMAIL=you@yourdomain.com
ZOHO_APP_PASSWORD=change-me

# Shared secret for the n8n workflow that calls POST /api/ops/leads/[id]/send
# on a schedule (no browser session available). Sent as the x-ops-automation-key
# header; compared with a constant-time check in proxy.ts. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPS_AUTOMATION_KEY=change-me

# Hunter.io API key used for the credits-remaining widget (free account endpoint, no credits consumed)
HUNTER_API_KEY=change-me

# n8n webhook that turns a work note into a full blog draft (writes to blog_posts itself)
N8N_BLOG_DRAFT_WEBHOOK_URL=change-me

# Cloudinary cloud name used to build public blog cover image URLs (no secret needed for delivery URLs)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=change-me

# n8n webhooks that trigger the lead-gen and drafting workflows from the ops dashboard
N8N_LEADGEN_WEBHOOK_URL=change-me
N8N_DRAFTING_WEBHOOK_URL=change-me

# Anthropic API key used to generate new quiz questions for weak topics
ANTHROPIC_API_KEY=change-me
